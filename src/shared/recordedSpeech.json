    "url": "/assets/voices/masha/398486d3d28bc6a456629a4c.mp3",
    "duration": 3.578
  },
  {
    "text": "Bear, wait for me!",
    "lang": "en",
    "url": "/assets/voices/masha/ec4d4333fe5f79a5e8c1efb2.mp3",
    "duration": 1.88
  },
  {
    "text": "Bear, catch!",
    "lang": "en",
    "url": "/assets/voices/masha/2459d1fe7713f9234db035ce.mp3",
    "duration": 1.515
  },
  {
    "text": "Hooray! Bear caught a fish!",
