[
  {
    "text": "Welcome to our garden!",
    "lang": "en",
    "url": "/assets/voices/masha/416bfd15a31be9e4d3ed6f3a.mp3",
    "duration": 1.697
  },
  {
    "text": "Save a carrot for me!",
    "lang": "en",
